{
  "manifest_version": 3,
  "name": "Aether Supremacy v27.1",
  "version": "1.0",
  "description": "Keksijän, Saulin ja Auroran digitaalinen suojelija.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aether-v27-official@keksija.local"
    }
  }
}
