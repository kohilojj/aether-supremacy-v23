{
  "manifest_version": 3,
  "name": "Aether Supremacy v28",
  "version": "28.0",
  "description": "Muuttaa internetin ilkeyden kukkasiksi. Suojelija: Keksijä.",
  "permissions": ["activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "aether-official@keksija.local"
    }
  }
}
